# StarRocks Docker Deployer - configuration
# Copy to .env and adjust as needed: cp .env.example .env

# Image tag (e.g. latest, 3.4-latest, 3.3.11)
STARROCKS_VERSION=latest

# Run mode: shared_nothing (default) or shared_data
RUN_MODE=shared_nothing

# Cluster name prefix used for containers, networks and volumes
CLUSTER_NAME=starrocks

# Number of FE / BE nodes (multi-node mode only). FE count should be odd (1, 3, 5).
FE_COUNT=3
BE_COUNT=3

# Host ports exposed by the cluster entry FE
FE_QUERY_PORT=9030
FE_HTTP_PORT=8030

# Initial root password (set via mysql after first start). Leave empty for no password.
ROOT_PASSWORD=

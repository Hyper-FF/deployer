# StarRocks Docker Deployer - configuration
# Copy to .env and adjust as needed: cp .env.example .env

# --- Package & runtime ---------------------------------------------------------

# Filename of the StarRocks tarball, located under ./packages/
# (e.g. StarRocks-3.4.0.tar.gz). The tarball is expected to extract into a
# single top-level directory containing fe/ and be/ subdirectories.
PACKAGE_FILE=StarRocks.tar.gz

# Base image used to run FE / BE containers. Must contain a JDK (StarRocks
# FE needs Java). The deployer installs mysql-client + netcat-openbsd on first
# start of each container (cached in a shared apt volume).
BASE_IMAGE=eclipse-temurin:17-jdk-jammy

# --- Cluster shape -------------------------------------------------------------

# Cluster name prefix used for containers, network and volumes.
CLUSTER_NAME=starrocks

# Number of FE / BE nodes. FE_COUNT should be odd (1, 3, 5...) for quorum.
# FE_COUNT=1 BE_COUNT=1 is the "single-node" topology.
FE_COUNT=3
BE_COUNT=3

# --- Networking ----------------------------------------------------------------

# Host ports exposed by the cluster entry FE (FE-0).
FE_QUERY_PORT=9030
FE_HTTP_PORT=8030

# --- Initial setup -------------------------------------------------------------

# Optional: set the root password automatically after first start.
ROOT_PASSWORD=
